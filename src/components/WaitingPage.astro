---
import LetterGlitch from './LetterGlitch';
import Countdown from './Countdown.astro';

const eventStart = '2026-10-24T12:00:00+01:00'; // BST
const eventEnd = '2026-10-25T12:00:00+00:00'; // GMT
---
<main class="waiting-countdown">
  <Countdown targetDate={eventStart} endDate={eventEnd} showPhase />
</main>

<div class="waiting-background" aria-hidden="true">
  <LetterGlitch
    glitchSpeed={375}
    centerVignette
    client:load
  />
</div>

<style>
  .waiting-countdown {
    position: relative;
    z-index: 1;
    display: grid;
    min-height: 100svh;
    padding: 1rem;
    place-items: center;
  }

  .waiting-countdown :global(.countdown-phase) {
    flex-basis: 100%;
    font-size: 0.35em;
    text-transform: uppercase;
  }

  .waiting-countdown :global(.countdown-finished) {
    display: flex;
    flex-direction: column;
    gap: 0.25em;
    align-items: center;
  }

  .waiting-countdown :global(.countdown-finished small) {
    font-size: 0.4em;
    font-weight: normal;
  }

  .waiting-background {
    position: fixed;
    z-index: 0;
    inset: 0;
    background: #131313;
    pointer-events: none;
  }

  .waiting-background :global(astro-island) {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
